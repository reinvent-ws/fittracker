{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./assets/barbell-front-squat.png",
    "splash": {
      "image": "./assets/barbell-front-squat.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://n"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "name": "fitness-app",
    "slug": "fitness-app",
    "android": {
      "package": "com.anonymous.fitnessapp"
    }
  }
}
